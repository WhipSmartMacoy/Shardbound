; Shardbound — Godot 4.5 project
config_version=5

[application]

config/name="Shardbound"
config/description="Turn-based roguelite RPG with HD-2D visuals"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://assets/ui/icon.png"
config/windows_native_icon="res://assets/ui/icon.ico"
boot_splash/bg_color=Color(0.027, 0.024, 0.047, 1)
boot_splash/show_image=false

[autoload]

D="*res://scripts/data.gd"
Meta="*res://scripts/meta.gd"
Snd="*res://scripts/audio.gd"
UI="*res://scripts/ui.gd"
G="*res://scripts/game.gd"
Bt="*res://scripts/battle.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
